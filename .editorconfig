# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 100
trim_trailing_whitespace = true

[*.{php,html,twig,json,yaml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.json]
insert_final_newline = false

[*.csv]
insert_final_newline = false

[*.{ts,tsx,js,jsx}]
quote_type = single
